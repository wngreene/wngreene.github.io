---
import EntryMedia from './EntryMedia.astro';
interface Props {
  role: string;
  company: string;
  dates: string;
  location?: string;
  logo?: string;
  description?: string;
  links?: { label: string; url: string }[];
}

const { role, company, dates, location, logo, description, links = [] } = Astro.props;
---

<article class="card exp">
  <EntryMedia logo={logo} label={company} />
  <div class="entry-body">
    <h3 class="entry-title">{role}</h3>
    <p class="entry-sub">{company}</p>
    <p class="exp-dates">{dates}{location && <span class="sep"> · </span>}{location}</p>
    {description && <p class="exp-desc">{description}</p>}
    {links.length > 0 && (
      <p class="pub-links">
        [&thinsp; {links.map((l, i) => (<>{i > 0 && ', '}<a href={l.url}>{l.label}</a></>))} &thinsp;]
      </p>
    )}
  </div>
</article>
