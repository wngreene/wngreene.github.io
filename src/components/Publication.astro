---
import { PEOPLE } from '../data/site';

interface Props {
  title: string;
  authors: string[];
  venue: string;
  year: number;
  award?: string;
  image: string;
  links: { label: string; url: string }[];
}

const { title, authors, venue, year, award, image, links } = Astro.props;
const people = authors.map((key) => PEOPLE[key as keyof typeof PEOPLE]);
---

<article class="card pub">
  <img class="pub-thumb" src={image} alt="" width="138" loading="lazy" />
  <div class="entry-body">
    <div class="entry-meta">{venue} <span class="sep">&middot;</span> {year}</div>
    <h3 class="entry-title">{title}</h3>
    <p class="entry-sub">
      {
        people.map((person, i) => (
          <>
            {i > 0 && (i === people.length - 1 ? (people.length > 2 ? ', and ' : ' and ') : ', ')}
            {'url' in person && person.url ? <a href={person.url}>{person.name}</a> : person.name}
          </>
        ))
      }
    </p>
    {award && <p class="entry-note">{award}</p>}
    <p class="pub-links">
      [&thinsp; {links.map((link, i) => (<>{i > 0 && ', '}<a href={link.url}>{link.label}</a></>))} &thinsp;]
    </p>
  </div>
</article>
