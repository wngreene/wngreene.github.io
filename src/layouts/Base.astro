---
import { SITE } from '../data/site';
import SocialLinks from '../components/SocialLinks.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
    />
    <link rel="stylesheet" href="/css/main.css" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/assets/me.jpg', Astro.site).href} />
    <meta name="twitter:card" content="summary" />
  </head>

  <body>
    <div class="shell">
      {/* Portrait and nav sit in a rail beside the page intro; the main
          content below breaks out to the full width of the shell. */}
      <header class="masthead">
        <div class="rail">
          <img
            class="rail-portrait"
            src="/assets/me.jpg"
            alt="W. Nicholas Greene"
            width="152"
            height="154"
          />
          <div class="rail-links">
            <nav class="rail-nav">
              <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>About</a>
              <a
                href="/pubs.html"
                aria-current={Astro.url.pathname === '/pubs.html' ? 'page' : undefined}
                >Publications</a
              >
              <a
                href="/experience.html"
                aria-current={Astro.url.pathname === '/experience.html' ? 'page' : undefined}
                >Experience</a
              >
              <a href={SITE.cv}>CV</a>
            </nav>
            <SocialLinks size={18} class="rail-social" />
          </div>
        </div>
        <div class="intro">
          <slot name="intro" />
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <span class="footer-name">W. Nicholas Greene</span>
        <div class="footer-links">
          <a href={`mailto:${SITE.email}`}>Email</a>
          <SocialLinks size={16} />
        </div>
      </footer>
    </div>
  </body>
</html>
