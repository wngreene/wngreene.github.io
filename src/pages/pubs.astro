---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Publication from '../components/Publication.astro';

const pubs = (await getCollection('publications')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="Publications" description="Publications by W. Nicholas Greene.">
  <Fragment slot="intro">
    <h1>Publications</h1>
    <div class="caps role">Robotics &middot; Computer Vision &middot; 3D Perception</div>
  </Fragment>

  <section>
    <div class="section-head">
      <h2>All publications</h2>
      <span class="caps" style="color: var(--faint);">{pubs.length} total</span>
    </div>
    <div class="entry-list">
      {pubs.map((pub) => <Publication {...pub.data} />)}
    </div>
  </section>
</Base>
